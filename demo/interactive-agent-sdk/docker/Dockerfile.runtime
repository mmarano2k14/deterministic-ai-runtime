FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .

RUN dotnet publish \
    implementations/dotnet/src/Multiplexed.AI.McpServer.Host/Multiplexed.AI.McpServer.Host.csproj \
    -c Release \
    -o /app/publish \
    --nologo

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8081 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_EnableDiagnostics=0

EXPOSE 8081

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=24 \
  CMD curl --fail --silent --show-error http://127.0.0.1:8081/health >/dev/null || exit 1

ENTRYPOINT ["dotnet", "Multiplexed.AI.McpServer.Host.dll"]
