# Public runtime endpoint.
AI_RUNTIME_ENDPOINT=http://localhost:8081/mcp

# Public transport authentication. Leave empty only when the target runtime
# is intentionally configured without bearer authentication.
AI_RUNTIME_TOKEN=

# Public RBAC/access context forwarded as a transport header.
AI_RUNTIME_ACCESS_CONTEXT=
AI_RUNTIME_ACCESS_CONTEXT_HEADER=X-Access-Context

# Language-specific hosted execution environments used by the selected demo.
AI_RUNTIME_DOTNET_ENVIRONMENT_REF=
AI_RUNTIME_TYPESCRIPT_ENVIRONMENT_REF=
AI_RUNTIME_PYTHON_ENVIRONMENT_REF=

# Reserved for the next agent implementation increment.
# They are not consumed by the current scaffold.
OPENAI_API_KEY=
OPENAI_MODEL=
