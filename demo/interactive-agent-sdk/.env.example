# Public MCP runtime endpoint for native/source-mode execution.
AI_RUNTIME_ENDPOINT=http://localhost:8081/mcp

# Real JWT bearer credential issued by the trusted identity boundary.
AI_RUNTIME_TOKEN=

# Optional. If absent, the .NET, TypeScript, and Python demos create the initial RBAC access context
# automatically through AI_RUNTIME_ACCESS_CONTEXT_ENDPOINT.
AI_RUNTIME_ACCESS_CONTEXT=
AI_RUNTIME_ACCESS_CONTEXT_ENDPOINT=http://localhost:8081/auth/access-context
AI_RUNTIME_ACCESS_CONTEXT_HEADER=X-Access-Context

# Runtime-native OpenAI prompt model selected by the external consumer pipeline.
OPENAI_MODEL=gpt-5.4

# Presentation mode is the default. Set true to show raw SDK watch events and command diagnostics.
AI_DEMO_VERBOSE=false

# OPENAI_API_KEY belongs to the runtime host, not the external SDK consumer.
# Configure it on the MCP/control-plane/runtime host (or OpenAI:ApiKey).

# Local development JWT issuer inputs.
# These mirror the standalone host's symmetric JWT configuration.
# Never expose the signing key to a real external application in production.
AiMcpAuthentication__Issuer=multiplexed-local
AiMcpAuthentication__Audience=multiplexed-ai-sdk
AiMcpAuthentication__SymmetricSigningKey=

AI_DEMO_PROJECT=rbac-demo
AI_DEMO_NAMESPACE=default
AI_DEMO_USER_ID=interactive-agent-demo
AI_DEMO_TENANT_ID=interactive-agent-tenant
AI_DEMO_TENANT_GROUP_ID=interactive-agent-group
AI_DEMO_TOKEN_TTL_SECONDS=3600

# The current .NET, TypeScript, and Python vertical slices use only native runtime steps.
AI_RUNTIME_DOTNET_ENVIRONMENT_REF=
AI_RUNTIME_TYPESCRIPT_ENVIRONMENT_REF=
AI_RUNTIME_PYTHON_ENVIRONMENT_REF=
