# Public runtime endpoint.
AI_RUNTIME_ENDPOINT=http://localhost:8081/mcp

# Public transport authentication. Leave empty only when the target runtime
# is intentionally configured without bearer authentication.
AI_RUNTIME_TOKEN=

# Public RBAC/access context forwarded as a transport header.
AI_RUNTIME_ACCESS_CONTEXT=
AI_RUNTIME_ACCESS_CONTEXT_HEADER=X-Access-Context

# Runtime-native OpenAI prompt model selected by the .NET consumer pipeline.
OPENAI_MODEL=gpt-5.4

# OPENAI_API_KEY belongs to the runtime host, not the external SDK consumer.
# Configure it on the MCP/control-plane/runtime host (or OpenAI:ApiKey).
# It is intentionally not read or transported by the .NET demo client.

# The current .NET vertical slice uses only native runtime steps and therefore
# does not require a hosted-function environment reference.
# These remain for the TypeScript/Python scaffold consumers and later slices.
AI_RUNTIME_DOTNET_ENVIRONMENT_REF=
AI_RUNTIME_TYPESCRIPT_ENVIRONMENT_REF=
AI_RUNTIME_PYTHON_ENVIRONMENT_REF=
