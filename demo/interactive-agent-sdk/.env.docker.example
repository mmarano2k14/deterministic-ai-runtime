# Required: server-owned OpenAI credential. It is injected only into the runtime container.
OPENAI_API_KEY=

# Runtime-native model referenced by the published demo pipelines.
OPENAI_MODEL=gpt-5.4

# Optional host port on the developer machine.
AI_DEMO_RUNTIME_PORT=8081

# Presentation mode is the default. Set true for raw SDK watch/command diagnostics.
AI_DEMO_VERBOSE=false

# Local Docker demo JWT settings.
# The default signing key is intentionally local-demo-only and must never be reused in production.
AI_DEMO_JWT_ISSUER=multiplexed-local
AI_DEMO_JWT_AUDIENCE=multiplexed-ai-sdk
AI_DEMO_SIGNING_KEY=local-demo-only-signing-key-please-change-2026

AI_DEMO_PROJECT=rbac-demo
AI_DEMO_NAMESPACE=default
AI_DEMO_USER_ID=interactive-agent-demo
AI_DEMO_TENANT_ID=interactive-agent-tenant
AI_DEMO_TENANT_GROUP_ID=interactive-agent-group
AI_DEMO_TOKEN_TTL_SECONDS=3600
