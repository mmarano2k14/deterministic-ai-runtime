{
  "AiMcpHost": {
    "Mode": "ControlPlaneWithLocalRuntimeInstances",
    "Port": 8080,
    "EnableSharedQueuePump": true,
    "SharedQueuePumpIntervalSeconds": 5,
    "EnableReplayTools": true,
    "EnableObservabilityTools": true
  },

  "AiRuntimeInstanceRegistration": {
    "Enabled": true,
    "RuntimeInstanceId": "mcp-control-plane",
    "ProviderName": "local",
    "WorkerCount": 30,
    "HeartbeatInterval": "00:00:02",
    "MaxConcurrentRuns": 30,
    "QueueCapacity": 100,
    "RuntimeVersion": "dev",

    "ProviderMetadata": {
      "environment": "development"
    },

    "Metadata": {
      "hostType": "control-plane-with-local-runtime",
      "deployment": "local"
    }
  },

  "AiLocalRuntimeInstancePool": {
    "Enabled": true,
    "InstanceCount": 3,
    "WorkerCountPerInstance": 10,
    "MaxConcurrentRunsPerInstance": 3,
    "LocalQueueCapacity": null,
    "RuntimeInstanceIdPrefix": "mcp-runtime"
  },

  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  },

  "Mongo": {
    "DatabaseName": "multiplexed-ai"
  },

  "AiEngine": {
    "Snapshots": {
      "Enabled": true,
      "Mongo": {
        "Enabled": true,
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "multiplexed-ai"
      }
    }
  }
}