<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.33.0" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.71.0" />
		<PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
		<PackageReference Include="Grpc.Tools" Version="2.76.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="MongoDB.Driver" Version="3.7.1" />
		<PackageReference Include="OpenAI" Version="2.10.0" />
		<PackageReference Include="SharpCompress" Version="0.48.1" />
		<PackageReference Include="Snappier" Version="1.3.1" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Runtime\ControlPlane\RuntimeInstances\Providers\Grpc\Protos\ai_runtime_instance_command.proto" GrpcServices="Both" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Multiplexed.Abstractions\Multiplexed.Abstractions.csproj" />
		<ProjectReference Include="..\Multiplexed.Rbac.Core\Multiplexed.Rbac.Core.csproj" />
		<ProjectReference Include="..\Multiplexed.Realtime\Multiplexed.Realtime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Config\**\*.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Config\retry-budget-maxretries-0.json" />
		<Content Remove="Config\retry-budget-maxretries-1.json" />
		<Content Remove="Config\retry-budget-maxretries-2.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Runtime\Observability\Metrics\Retention\AiRetentionDecisionMetrics.cs" />
	</ItemGroup>

</Project>