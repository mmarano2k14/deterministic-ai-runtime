<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Acheve.TestHost" Version="4.0.0" />
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="FluentAssertions" Version="8.10.0" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="SharpCompress" Version="0.48.1" />
		<PackageReference Include="Snappier" Version="1.3.1" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Multiplexed.Abstractions\Multiplexed.Abstractions.csproj" />
		<ProjectReference Include="..\..\src\Multiplexed.AI\Multiplexed.AI.csproj" />
		<ProjectReference Include="..\..\src\Multiplexed.AI.McpServer\Multiplexed.AI.McpServer.csproj" />
		<ProjectReference Include="..\..\src\Multiplexed.Rbac.Core\Multiplexed.Rbac.Core.csproj" />
		<ProjectReference Include="..\..\src\Multiplexed.Realtime\Multiplexed.Realtime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Runtime\Execution\State\" />
		<Folder Include="Runtime\Retry\" />
	</ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\Multiplexed.AI.WorkerProtocol.Probe\Multiplexed.AI.WorkerProtocol.Probe.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- The probe owns its launch files. Do not copy transitive content before its build. -->
  <Target Name="CopyWorkerProtocolProbe" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_WorkerProtocolProbeFiles Remove="@(_WorkerProtocolProbeFiles)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Multiplexed.AI.WorkerProtocol.Probe\Multiplexed.AI.WorkerProtocol.Probe.csproj"
             Targets="BuildAndGetWorkerProtocolProbeFiles"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RebaseOutputs="true" StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerProtocolProbeFiles" />
    </MSBuild>
    <Error Condition="'@(_WorkerProtocolProbeFiles)' == ''"
           Text="The worker protocol probe did not return its required launch files." />
    <Copy SourceFiles="@(_WorkerProtocolProbeFiles)" DestinationFolder="$(TargetDir)worker-probe" SkipUnchangedFiles="true" />
  </Target>

  <!-- Build deployment/test-only .NET worker artifacts without loading them into the test assembly. -->
  <Target Name="CopyHostedDotNetWorkerFixture" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_HostedDotNetFixtureFiles Remove="@(_HostedDotNetFixtureFiles)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\workers\Multiplexed.AI.HostedInvocation.DotNetWorker\Multiplexed.AI.HostedInvocation.DotNetWorker.csproj"
             Targets="Restore;BuildAndGetHostedDotNetWorkerFiles"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RebaseOutputs="true" StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_HostedDotNetFixtureFiles" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Multiplexed.AI.HostedInvocation.TestDependency\Multiplexed.AI.HostedInvocation.TestDependency.csproj"
             Targets="Restore;BuildAndGetHostedDotNetTestDependency"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RebaseOutputs="true" StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_HostedDotNetFixtureFiles" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Multiplexed.AI.HostedInvocation.TestFunctions\Multiplexed.AI.HostedInvocation.TestFunctions.csproj"
             Targets="Restore;BuildAndGetHostedDotNetTestFunctions"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RebaseOutputs="true" StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_HostedDotNetFixtureFiles" />
    </MSBuild>
    <Error Condition="'@(_HostedDotNetFixtureFiles)' == ''"
           Text="Hosted .NET worker fixture did not return its required build outputs." />
    <Copy SourceFiles="@(_HostedDotNetFixtureFiles)" DestinationFolder="$(TargetDir)dotnet-worker-fixture" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Multiplexed.AI.ContainerEngine.Probe\Multiplexed.AI.ContainerEngine.Probe.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyContainerEngineProbe" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_ContainerEngineProbeFiles Remove="@(_ContainerEngineProbeFiles)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Multiplexed.AI.ContainerEngine.Probe\Multiplexed.AI.ContainerEngine.Probe.csproj"
             Targets="BuildAndGetContainerEngineProbeFiles"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RebaseOutputs="true" StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ContainerEngineProbeFiles" />
    </MSBuild>
    <Error Condition="'@(_ContainerEngineProbeFiles)' == ''"
           Text="The container engine probe did not return its required launch files." />
    <Copy SourceFiles="@(_ContainerEngineProbeFiles)" DestinationFolder="$(TargetDir)container-engine-probe" SkipUnchangedFiles="true" />
  </Target>
</Project>
