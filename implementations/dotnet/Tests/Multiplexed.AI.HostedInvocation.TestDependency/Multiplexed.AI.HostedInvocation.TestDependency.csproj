<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="BuildAndGetHostedDotNetTestDependency" DependsOnTargets="Restore;Build"
          Returns="$(TargetPath)" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetPath)')" Text="Hosted .NET test dependency output is missing." />
  </Target>
</Project>
