<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Multiplexed.AI.HostedInvocation.TestDependency\Multiplexed.AI.HostedInvocation.TestDependency.csproj" />
  </ItemGroup>
  <Target Name="BuildAndGetHostedDotNetTestFunctions" DependsOnTargets="Restore;Build"
          Returns="$(TargetPath)" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetPath)')" Text="Hosted .NET test function output is missing." />
  </Target>
</Project>
