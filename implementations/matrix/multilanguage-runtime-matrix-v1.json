  "coverageTargets": [
    {
      "id": "publication-pinning",
      "minimumExecutedScenarios": 3,
      "requiredWorkerLanguages": [
        "dotnet",
        "typescript",
        "python"
      ],
      "requiredValues": [],
      "notes": "Each hosted language must prove that an already submitted execution remains bound to its immutable publication after a later publication is created."
    },
    {
      "id": "deterministic-dependency-packaging",
      "minimumExecutedScenarios": 3,
      "requiredWorkerLanguages": [
        "dotnet",
        "typescript",
        "python"
      ],
      "requiredValues": [
        "DotNetAssemblyClosure",
        "NodeLockedBundle",
        "PythonWheelBundle"
      ],
      "notes": "Package coverage follows the supported package kind for the hosted execution language; no runtime package installation is permitted."
    },
    {
      "id": "custom-policy-family",
      "minimumExecutedScenarios": 3,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "concurrency",
        "retry",
        "delegation"
      ],
      "notes": "Only the hosted policy families already supported by the runtime are in scope. No other policy family is implied."
    },
    {
      "id": "nested-child-dag",
      "minimumExecutedScenarios": 3,
      "requiredWorkerLanguages": [
        "dotnet",
        "typescript",
        "python"
      ],
      "requiredValues": [],
      "notes": "Exercise published custom declarations inside nested Child DAGs while preserving the existing parent continuation authority."
    },
    {
      "id": "cancellation",
      "minimumExecutedScenarios": 3,
      "requiredClientLanguages": [
        "dotnet",
        "typescript",
        "python"
      ],
      "requiredWorkerLanguages": [],
      "requiredValues": [],
      "notes": "Each external SDK must exercise the explicit durable cancellation operation. Transport cancellation alone does not satisfy this target."
    },
    {
      "id": "recovery",
      "minimumExecutedScenarios": 2,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "in-flight-resume",
        "local-queued-redispatch"
      ],
      "notes": "Use the existing recovery authorities and record the exact recovery path exercised."
    },
    {
      "id": "mcp-effect-evidence",
      "minimumExecutedScenarios": 2,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "completed-local-replay",
        "uncertain-blocks-blind-resend"
      ],
      "notes": "The matrix proves durable effect evidence behavior without claiming generic exactly-once delivery."
    },
    {
      "id": "journal-result-acceptance",
      "minimumExecutedScenarios": 2,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "accepted-result-replay",
        "duplicate-delivery-convergence"
      ],
      "notes": "Result acceptance remains owned by the existing durable invocation journal and epoch rules."
    },
    {
      "id": "worker-isolation-provider",
      "minimumExecutedScenarios": 2,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "trusted-process",
        "sandboxed-container"
      ],
      "notes": "A trusted process and an applied sandboxed container are separate profiles; neither may be reported as the other."
    },
    {
      "id": "isolation-artifact-selection",
      "minimumExecutedScenarios": 2,
      "requiredWorkerLanguages": [],
      "requiredValues": [
        "HostRuntime",
        "OciImage"
      ],
      "notes": "The SDK expresses execution requirements while the server selects the physical provider."
    },
    {
      "id": "external-client-dependency-firewall",
      "minimumExecutedScenarios": 3,
      "requiredClientLanguages": [
        "dotnet",
        "typescript",
        "python"
      ],
      "requiredWorkerLanguages": [],
      "requiredValues": [],
      "notes": "Validate that each external client remains free of engine/runtime dependencies."
    }
  ],
