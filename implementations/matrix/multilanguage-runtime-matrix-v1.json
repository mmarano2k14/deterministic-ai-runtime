          "--project",
          "implementations/matrix/clients/dotnet/Multiplexed.AI.Matrix.DotNetClient/Multiplexed.AI.Matrix.DotNetClient.csproj",
          "--"
        ]
      },
      "requiredEvidence": [
        "publish",
        "submit",
        "observe",
        "terminal-result",
