{
  "AiMcpHost": {
    "Mode": "ControlPlaneWithLocalRuntimeInstances",
    "Port": 8081,
    "EnableSharedQueuePump": false,
    "EnableReplayTools": false,
    "EnableObservabilityTools": false
  },
  "AiRuntimeInstanceRegistration": {
    "Enabled": true,
    "RuntimeInstanceId": "mcp-runtime-local",
    "ProviderName": "local",
    "WorkerCount": 30,
    "HeartbeatInterval": "00:00:02",
    "MaxConcurrentRuns": 30,
    "QueueCapacity": 100,
    "RuntimeVersion": "dev",
    "ProviderMetadata": {
      "provider.name": "local"
    },
    "Metadata": {
      "hostType": "control-plane-with-local-runtime",
      "deployment": "local"
    }
  },
  "AiLocalRuntimeInstancePool": {
    "Enabled": true,
    "InstanceCount": 3,
    "WorkerCountPerInstance": 10,
    "MaxConcurrentRunsPerInstance": 5,
    "LocalQueueCapacity": null,
    "RuntimeInstanceIdPrefix": "mcp-runtime-local"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379",
    "Mongo": "mongodb://localhost:27017"
  },
  "Mongo": {
    "DatabaseName": "multiplexed-ai"
  },
  "AiEngine": {
    "Snapshots": {
      "Enabled": true,
      "Mongo": {
        "Enabled": true,
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "multiplexed-ai"
      }
    },
    "PipelineBackgroundController": {
      "MaxConcurrentRuns": 5,
      "QueueCapacity": 1000,
      "RejectEnqueueWhenStopped": false,
      "StopOnFirstFailure": false,
      "Distributed": {
        "Enabled": true,
        "WorkerCount": 10,
        "StopOnFirstTerminal": true,
        "TerminalObservationTimeout": "00:00:30"
      }
    },
    "RuntimeInstanceWorker": {
      "MaxCycles": 0,
      "MaxStepsPerCycle": 1,
      "IdleDelay": "00:00:00.025",
      "IgnoreConcurrencyConflicts": true
    }
  }
}